<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text colours of the dark theme (the default). Layouts do not use these directly: they read the matching
         attribute (res/values/attrs.xml), which Theme.TvHome points here and ThemeOverlay.TvHome.Abyss can override. The Clock screensaver and the focused rows still use them as they are. -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_strong">#F2FFFFFF</color>
    <color name="text_emphasis">#E6FFFFFF</color>
    <color name="text_body">#D9FFFFFF</color>
    <color name="text_secondary">#B3FFFFFF</color>
    <color name="text_label">#A6FFFFFF</color>
    <color name="text_muted">#99FFFFFF</color>
    <color name="text_eyebrow">#8CFFFFFF</color>
    <color name="text_hint">#80FFFFFF</color>
    <color name="text_dim">#73FFFFFF</color>
    <color name="text_faint">#66FFFFFF</color>
    <color name="text_settings_note">#FFACB8C1</color>
    <color name="text_on_light">#FF111111</color>
    <color name="text_on_light_mid">#E6111111</color>
    <color name="text_on_light_dim">#99111111</color>
    <color name="text_success">#FF1FA84F</color>   <!-- readable on both the black row and the white focused row -->
</resources>
