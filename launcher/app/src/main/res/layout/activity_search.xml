<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/search"
            android:textColor="#8CFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.22"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/query"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/search_field_bg"
                android:hint="@string/search_hint"
                android:textColorHint="@drawable/pill_text_dim"
                android:textColor="@drawable/pill_text"
                android:textSize="20sp"
                android:fontFamily="@font/outfit"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
                android:inputType="text|textNoSuggestions"
                android:nextFocusDown="@+id/filter" />
        </LinearLayout>

        <!-- Under the field so the remote's Down key reaches it: Right would only move the text cursor. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/filter"
                style="@style/TopButton"
                android:layout_marginStart="0dp"
                android:text="@string/search_filter_on"
                android:nextFocusUp="@id/query"
                android:nextFocusDown="@+id/results" />

            <LinearLayout
                android:id="@+id/extras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="@string/search_intro"
                android:textColor="#A6FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="30dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>
</FrameLayout>
