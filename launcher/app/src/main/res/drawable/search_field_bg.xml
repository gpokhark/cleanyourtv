<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/pill_focus_fill" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="?attr/pill_fill_top" android:endColor="?attr/pill_fill_bottom" />
            <stroke android:width="1dp" android:color="?attr/pill_stroke" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
