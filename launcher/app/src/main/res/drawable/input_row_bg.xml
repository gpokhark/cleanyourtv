<?xml version="1.0" encoding="utf-8"?>
<!-- A list row: clear until focused, then frosted glass like the highlight on Home. a light, see-through
     fill with a bright edge. The text on it stays white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="?attr/row_focus_top" android:endColor="?attr/row_focus_bottom" />
            <stroke android:width="1.5dp" android:color="?attr/row_focus_stroke" />
            <corners android:radius="?attr/radius_row" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="?attr/radius_row" />
        </shape>
    </item>
</selector>
