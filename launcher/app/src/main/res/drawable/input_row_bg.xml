<?xml version="1.0" encoding="utf-8"?>
<!-- A list row: clear until focused, then frosted glass (a light, see-through fill with a bright edge) like the
     highlight on Home, so the white text on it stays readable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4DFFFFFF" android:endColor="#26FFFFFF" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
