<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/choice_focus_fill" />
            <corners android:radius="?attr/radius_choice" />
            <stroke android:width="2dp" android:color="?attr/choice_focus_stroke" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/choice_selected_fill" />
            <corners android:radius="?attr/radius_choice" />
            <stroke android:width="1dp" android:color="?attr/choice_selected_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/choice_bg" />
            <corners android:radius="?attr/radius_choice" />
        </shape>
    </item>
</selector>
